{
  "expo": {
    "name": "MYTHØS RP",
    "slug": "mythos-rp-launcher",
    "version": "0.6.1",
    "orientation": "portrait",
    "owner": "mythosstudios-team",
    "android": {
      "package": "br.com.mythos.rp",
      "versionCode": 8,
      "permissions": [
        "INTERNET",
        "REQUEST_INSTALL_PACKAGES",
        "MANAGE_EXTERNAL_STORAGE",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "category": ["BROWSABLE", "DEFAULT"],
          "data": [{"scheme": "samp"}]
        }
      ]
    },
    "plugins": [],
    "updates": {"fallbackToCacheTimeout": 0}
  }
}
