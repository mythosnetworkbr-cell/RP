{
  "expo": {
    "name": "MYTHØS SAMP",
    "slug": "mythos-samp",
    "version": "2.6.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "icon": "./assets/app-icon.png",
    "backgroundColor": "#05030a",
    "primaryColor": "#c04eff",
    "splash": {"image":"./assets/app-icon.png","resizeMode":"contain","backgroundColor":"#05030a"},
    "android": {
      "package": "br.com.mythos.samp",
      "versionCode": 19,
      "permissions": ["INTERNET","REQUEST_INSTALL_PACKAGES","MANAGE_EXTERNAL_STORAGE"],
      "softwareKeyboardLayoutMode": "resize",
      "intentFilters": [{"action":"VIEW","category":["BROWSABLE","DEFAULT"],"data":[{"scheme":"samp"}]}]
    },
    "updates": {"fallbackToCacheTimeout": 0}
  }
}
