{
  "expo": {
    "name": "MYTHØS Launcher",
    "slug": "mythos-launcher",
    "version": "2.4.0",
    "orientation": "default",
    "owner": "mythosstudios-team",
    "icon": "./assets/app-icon.png",
    "backgroundColor": "#030007",
    "primaryColor": "#9b2cff",
    "splash": {
      "image": "./assets/app-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#030007"
    },
    "android": {
      "package": "br.com.mythos.rp",
      "versionCode": 14,
      "permissions": [
        "INTERNET",
        "REQUEST_INSTALL_PACKAGES",
        "MANAGE_EXTERNAL_STORAGE",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "category": ["BROWSABLE", "DEFAULT"],
          "data": [{"scheme": "samp"}]
        }
      ]
    },
    "plugins": [
      ["expo-audio", {"recordAudioAndroid": false}]
    ],
    "updates": {"fallbackToCacheTimeout": 0}
  }
}
