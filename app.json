{
  "expo": {
    "name": "MYTHØS Launcher",
    "slug": "mythos-launcher",
    "version": "2.5.1",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "icon": "./assets/app-icon.png",
    "backgroundColor": "#050505",
    "primaryColor": "#19ff62",
    "splash": {"image":"./assets/app-icon.png","resizeMode":"contain","backgroundColor":"#050505"},
    "android": {
      "package": "br.com.mythos.rp",
      "versionCode": 18,
      "permissions": ["INTERNET","REQUEST_INSTALL_PACKAGES","MANAGE_EXTERNAL_STORAGE"],
      "softwareKeyboardLayoutMode": "resize",
      "intentFilters": [{"action":"VIEW","category":["BROWSABLE","DEFAULT"],"data":[{"scheme":"samp"}]}]
    },
    "updates": {"fallbackToCacheTimeout": 0}
  }
}
